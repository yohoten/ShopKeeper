# ============================================================
# 铺掌柜 ShopKeeper — Git 忽略规则
# ============================================================

# --- Python 缓存 ---
__pycache__/
*.py[cod]
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- 虚拟环境（体积大且可通过 requirements.txt 重建）---
.venv/
venv/
env/
ENV/

# --- PyInstaller 构建产物 ---
build/
dist/
*.spec
*.exe
*.dll
*.pyd

# --- 运行数据：数据库、备份、日志（含 WAL 模式附属文件）---
/*.db
/*.db-shm
/*.db-wal
data/*.db
data/*.db-shm
data/*.db-wal
data/backups/
data/logs/
logs/
*.log

# --- 运行时生成的 Excel（保留种子文件 商品资料.xlsx）---
data/销售历史.xlsx
data/进货管理.xlsx

# --- 编辑器与操作系统 ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- 本地配置与密钥 ---
.env
*.local
.streamlit/secrets.toml
